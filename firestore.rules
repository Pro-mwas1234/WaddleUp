rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMascot(m) {
      return m is string && m in ['DUCK', 'FROG', 'SNAIL', 'PIGEON', 'FLAMINGO', 'DINO', 'POTATO', 'CRAB'];
    }

    function isValidAvatarCode(code) {
      return code is string && code.size() <= 64 && code.matches('^[A-Z0-9_:]*$');
    }

    function isValidPowerUp(p) {
      return p is string && p in ['', 'SNAILS_PACE', 'ROCKET_BOOST', 'DISCO_FEVER', 'SNACK_MAGNET'];
    }

    function isValidNudgeType(t) {
      return t is string && t in ['QUACK_ATTACK', 'COUCH_ALERT', 'SNAIL_PACE', 'CROWN_THREAT', 'HIGH_FIVE'];
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Entity Validators ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             isValidMascot(data.mascot) &&
             (!('avatarCode' in data) || isValidAvatarCode(data.avatarCode)) &&
             data.bio is string && data.bio.size() <= 80 &&
             data.dailyGoal is int && data.dailyGoal >= 1000 && data.dailyGoal <= 100000 &&
             data.todaySteps is int && data.todaySteps >= 0 && data.todaySteps <= 300000 &&
             isValidDateString(data.todayDate) &&
             data.weeklySteps is int && data.weeklySteps >= 0 && data.weeklySteps <= 2100000 &&
             isValidDateString(data.weekStartDate) &&
             (!('bestDailySteps' in data) || (data.bestDailySteps is int && data.bestDailySteps >= 0 && data.bestDailySteps <= 300000)) &&
             (!('activePowerUp' in data) || isValidPowerUp(data.activePowerUp)) &&
             (!('powerUpExpiresAtMs' in data) || (data.powerUpExpiresAtMs is int && data.powerUpExpiresAtMs >= 0)) &&
             data.totalNudgesSent is int && data.totalNudgesSent >= 0 && data.totalNudgesSent <= 100000 &&
             (!('dailyHistory' in data) || (data.dailyHistory is map && data.dailyHistory.size() <= 14)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSquad(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 40 &&
             isValidInviteCode(data.inviteCode) &&
             data.motto is string && data.motto.size() <= 80 &&
             data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 25 &&
             data.memberIds[0] is string &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSquadInvite(data) {
      return data.squadId is string && isValidId(data.squadId) &&
             data.squadName is string && data.squadName.size() >= 2 && data.squadName.size() <= 40 &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSquadMember(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.squadId is string && isValidId(data.squadId) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             isValidMascot(data.mascot) &&
             (!('avatarCode' in data) || isValidAvatarCode(data.avatarCode)) &&
             data.bio is string && data.bio.size() <= 80 &&
             data.dailyGoal is int && data.dailyGoal >= 1000 && data.dailyGoal <= 100000 &&
             data.todaySteps is int && data.todaySteps >= 0 && data.todaySteps <= 300000 &&
             isValidDateString(data.todayDate) &&
             data.weeklySteps is int && data.weeklySteps >= 0 && data.weeklySteps <= 2100000 &&
             isValidDateString(data.weekStartDate) &&
             (!('activePowerUp' in data) || isValidPowerUp(data.activePowerUp)) &&
             (!('powerUpExpiresAtMs' in data) || (data.powerUpExpiresAtMs is int && data.powerUpExpiresAtMs >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNudge(data) {
      return data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 30 &&
             isValidMascot(data.senderMascot) &&
             (!('senderAvatarCode' in data) || isValidAvatarCode(data.senderAvatarCode)) &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.squadId is string && isValidId(data.squadId) &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 120 &&
             isValidNudgeType(data.nudgeType) &&
             data.acknowledged is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Action Predicates ---
    function isJoinSquadAction() {
      return !(request.auth.uid in existing().memberIds) &&
             (request.auth.uid in incoming().memberIds) &&
             incoming().memberIds.hasAll(existing().memberIds) &&
             incoming().memberIds.size() == existing().memberIds.size() + 1;
    }

    function isLeaveSquadAction() {
      return (request.auth.uid in existing().memberIds) &&
             !(request.auth.uid in incoming().memberIds) &&
             existing().memberIds.hasAll(incoming().memberIds) &&
             existing().memberIds.size() == incoming().memberIds.size() + 1;
    }

    // --- Collection Rules ---

    // 1. User Profiles (strict owner-only read/write, zero PII)
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'mascot', 'bio', 'dailyGoal', 'todaySteps', 'todayDate', 'weeklySteps', 'weekStartDate', 'totalNudgesSent', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'mascot', 'avatarCode', 'bio', 'dailyGoal', 'todaySteps', 'todayDate', 'weeklySteps', 'weekStartDate', 'bestDailySteps', 'activePowerUp', 'powerUpExpiresAtMs', 'dailyHistory', 'totalNudgesSent', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'mascot', 'avatarCode', 'bio', 'dailyGoal', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['todaySteps', 'todayDate', 'weeklySteps', 'weekStartDate', 'bestDailySteps', 'activePowerUp', 'powerUpExpiresAtMs', 'dailyHistory', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['activePowerUp', 'powerUpExpiresAtMs', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['totalNudgesSent', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // 2. Incoming Nudges / Heckles (owner reads/acks/deletes; shared squadmates create)
      match /nudges/{nudgeId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(nudgeId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().recipientId == userId &&
                         incoming().acknowledged == false &&
                         incoming().keys().hasAll(['senderId', 'senderName', 'senderMascot', 'recipientId', 'squadId', 'message', 'nudgeType', 'acknowledged', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['senderId', 'senderName', 'senderMascot', 'senderAvatarCode', 'recipientId', 'squadId', 'message', 'nudgeType', 'acknowledged', 'createdAt', 'updatedAt']) &&
                         isValidNudge(incoming()) &&
                         exists(/databases/$(database)/documents/squads/$(incoming().squadId)) &&
                         (request.auth.uid in get(/databases/$(database)/documents/squads/$(incoming().squadId)).data.memberIds) &&
                         (userId in get(/databases/$(database)/documents/squads/$(incoming().squadId)).data.memberIds);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(nudgeId) &&
                         request.auth.uid == userId &&
                         incoming().senderId == existing().senderId &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().squadId == existing().squadId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNudge(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(nudgeId) && request.auth.uid == userId;
      }
    }

    // 3. Friend Squads
    match /squads/{squadId} {
      allow get: if isSignedIn() && isValidId(squadId) && (request.auth.uid in existing().memberIds);
      allow list: if isSignedIn() && (request.auth.uid in existing().memberIds);

      allow create: if isSignedIn() &&
                       isValidId(squadId) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().memberIds.size() == 1 &&
                       incoming().memberIds[0] == request.auth.uid &&
                       incoming().keys().hasAll(['creatorId', 'name', 'inviteCode', 'motto', 'memberIds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['creatorId', 'name', 'inviteCode', 'motto', 'memberIds', 'createdAt', 'updatedAt']) &&
                       isValidSquad(incoming());

      allow update: if isSignedIn() &&
                       isValidId(squadId) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().inviteCode == existing().inviteCode &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSquad(incoming()) &&
                       (
                         (existing().creatorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'motto', 'updatedAt'])) ||
                         (isJoinSquadAction() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])) ||
                         (isLeaveSquadAction() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(squadId) && existing().creatorId == request.auth.uid;

      // 4. Squad Member Leaderboard Snapshots
      match /members/{memberId} {
        allow get: if isSignedIn() &&
                      isValidId(squadId) &&
                      isValidId(memberId) &&
                      (
                        request.auth.uid == memberId ||
                        (exists(/databases/$(database)/documents/squads/$(squadId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.memberIds)
                      );

        allow list: if false;

        allow create: if isSignedIn() &&
                         isValidId(squadId) &&
                         isValidId(memberId) &&
                         request.auth.uid == memberId &&
                         incoming().userId == request.auth.uid &&
                         incoming().squadId == squadId &&
                         incoming().keys().hasAll(['userId', 'squadId', 'displayName', 'mascot', 'bio', 'dailyGoal', 'todaySteps', 'todayDate', 'weeklySteps', 'weekStartDate', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'squadId', 'displayName', 'mascot', 'avatarCode', 'bio', 'dailyGoal', 'todaySteps', 'todayDate', 'weeklySteps', 'weekStartDate', 'activePowerUp', 'powerUpExpiresAtMs', 'createdAt', 'updatedAt']) &&
                         isValidSquadMember(incoming()) &&
                         (request.auth.uid in getAfter(/databases/$(database)/documents/squads/$(squadId)).data.memberIds);

        allow update: if isSignedIn() &&
                         isValidId(squadId) &&
                         isValidId(memberId) &&
                         request.auth.uid == memberId &&
                         incoming().userId == existing().userId &&
                         incoming().squadId == existing().squadId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSquadMember(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'mascot', 'avatarCode', 'bio', 'dailyGoal', 'todaySteps', 'todayDate', 'weeklySteps', 'weekStartDate', 'activePowerUp', 'powerUpExpiresAtMs', 'updatedAt']) &&
                         (request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.memberIds);

        allow delete: if isSignedIn() && isValidId(squadId) && isValidId(memberId) && request.auth.uid == memberId;
      }
    }

    // 5. Squad Invite Lookup (direct get by 6-char code only; no listing)
    match /squad_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidInviteCode(inviteCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidInviteCode(inviteCode) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().keys().hasAll(['squadId', 'squadName', 'creatorId', 'createdAt']) &&
                       incoming().keys().hasOnly(['squadId', 'squadName', 'creatorId', 'createdAt']) &&
                       isValidSquadInvite(incoming()) &&
                       getAfter(/databases/$(database)/documents/squads/$(incoming().squadId)).data.creatorId == request.auth.uid;

      allow update: if false;
      allow delete: if isSignedIn() && isValidInviteCode(inviteCode) && existing().creatorId == request.auth.uid;
    }
  }
}
